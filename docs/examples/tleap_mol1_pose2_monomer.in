# Example: tleap input as generated by run_full_pipeline.sh for
#   compound=mol1, pose=2  →  systems/mol1_pose2_monomer/
#
# Ligand position: ALL heavy-atom coordinates come from the docked GAFF2 mol2
#   params/inhibitors/mol2/mol1_gaff2.mol2
# (must be prepared with the ligand already placed in the monomer active site,
#  same coordinate frame as structures/monomer/monomer_BQ_apo.pdb).
#
# Assembly: protein = loadpdb (apo) ; LIG = loadmol2 ; mol = combine { protein LIG }
#
# Replace PROJECT_ROOT if you copy this file elsewhere.

source leaprc.protein.ff19SB
source leaprc.gaff2
source leaprc.water.tip3p

addAtomTypes {
        { "M1"  "Ni" "sp3" }
        { "M2"  "Ni" "sp3" }
        { "Y1"  "O" "sp3" }
        { "Y2"  "N" "sp3" }
        { "Y3"  "N" "sp3" }
        { "Y4"  "O" "sp3" }
        { "Y5"  "N" "sp3" }
        { "Y6"  "N" "sp3" }
        { "Y7"  "O" "sp3" }
        { "Y8"  "O" "sp3" }
}

KCX = loadmol2 /path/to/urease_md/params/ni_center/mcpb_input/KCX_full_stopgap.mol2
OHB = loadmol2 /path/to/urease_md/params/ni_center/mcpb_input/OHB.mol2
loadamberparams /path/to/urease_md/params/ni_center/mcpb_input/KCX.frcmod
loadamberparams /path/to/urease_md/params/ni_center/mcpb_input/OHB.frcmod
loadamberparams /path/to/urease_md/params/ni_center/mcpb_input/urease_mcpbpy.frcmod
loadamberparams /path/to/urease_md/systems/mol6_pose2_full/provisional_autopatch_optB.frcmod

loadamberparams /path/to/urease_md/params/inhibitors/frcmod/mol1.frcmod
LIG = loadmol2 /path/to/urease_md/params/inhibitors/mol2/mol1_gaff2.mol2
protein = loadpdb /path/to/urease_md/structures/monomer/monomer_BQ_apo.pdb
mol = combine { protein LIG }
check mol

source /path/to/urease_md/params/ni_center/monomer/bonds_monomer.txt
source /path/to/urease_md/params/ni_center/monomer/set_patch_monomer.txt

check mol
solvateoct mol TIP3PBOX 12.0
addionsrand mol Na+ 0
addionsrand mol Cl- 0

saveamberparm mol /path/to/urease_md/systems/mol1_pose2_monomer/monomer_mol1.prmtop /path/to/urease_md/systems/mol1_pose2_monomer/monomer_mol1.inpcrd

quit
