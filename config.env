# config.env
# -------------------------------------------------------
# Central configuration for the urease MD project.
# Source this file at the top of every script:
#     source "$(dirname "$0")/../config.env"
# -------------------------------------------------------

# === Project root ===
export PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

# GPU selection (P100 = device 1 with PCI bus order; used by pmemd.cuda drivers)
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-1}"
# MD driver scripts (e.g. scripts/run_production.sh) take the simulation basename only
# (e.g. mol6_pose2_monomer), not a path — see USAGE block in that script.

# === Software paths ===
export ORCA_PATH="/opt/software/ORCA/build/orca"
export ORCA_2MKL="${ORCA_PATH%/*}/orca_2mkl"
# pmemd.cuda lives here; sander/tleap/cpptraj are often in /usr/local (this install has no sander under AMBER_HOME)
export AMBER_HOME="/opt/software/AMBER/pmemd24"
# GPU MD: CUDA 12.8–linked build (libcufft.so.11). Do not use $AMBER_HOME/bin/pmemd.cuda for dynamics.
export PMEMD_CUDA_BIN="/opt/software/AMBER/pmemd24_cuda128/bin/pmemd.cuda"
export SANDER_BIN="/usr/local/bin/sander"
export MULTIWFN_PATH="/opt/software/Multiwfn/Multiwfn"

# === Hardware ===
# Dual-socket Xeon E5-2697 v3: 28 physical cores (14/socket), 2 NUMA nodes
# GPUs: Quadro K2200 (4 GB), Tesla P100-PCIE-16GB
export N_CPU_CORES=56
export TOTAL_CORES="${N_CPU_CORES}"
export N_PHYSICAL_CORES=28
export RAM_GB=62
export GPU_COUNT=2

# CPU MPI (equil_cpu_npt) — reserve cores for concurrent ORCA ligand jobs (%pal nprocs 6)
export ORCA_CORES=6
# pmemd.MPI for equil_cpu_npt and equil1–3 (CPU): ranks when ORCA idle (reserve headroom if ORCA runs).
# When ORCA jobs are running, run_equilibration.sh uses a smaller default (see script).
export MPI_CORES_NPT=50
# GPU 0: Quadro K2200 (4 GB, display). GPU 1: Tesla P100-PCIE-16GB (compute).
# CUDA_DEVICE_ORDER / CUDA_VISIBLE_DEVICES are set at top of this file.

# === ORCA resource allocation ===
# Use all 28 physical cores (HT hurts ORCA floating-point throughput)
# maxcore × nprocs must leave headroom for gradient evaluation overhead
# 28 × 1200 = 33.6 GB total; gradient steps can use ~2× SCF memory
export ORCA_NPROCS=28
export ORCA_MAXCORE=1200       # MB per core -> 28 × 1200 = 33.6 GB total

# === AMBER engine ===
# Basename for PATH resolution only; prefer PMEMD_CUDA_BIN everywhere.
export PMEMD_CUDA="pmemd.cuda"
export PMEMD_CPU="sander"
# Optional: override dynamics binary (default is pmemd.cuda via run_full_pipeline.sh).
# export PMEMD_MD_BIN="${AMBER_HOME}/bin/pmemd"

# === Force fields ===
export PROTEIN_FF="leaprc.protein.ff19SB"
export WATER_FF="leaprc.water.tip3p"
export LIGAND_FF="leaprc.gaff2"
export WATER_BOX="TIP3PBOX"

# === Simulation parameters ===
export BOX_BUFFER=9.0          # angstrom — solute-to-box-edge distance (rectangular TIP3PBOX)
export BOX_TYPE="rectangular"  # rectangular → solvatebox; octahedral → solvateoct (see build_monomer_system.sh)
export SALT_CONC=0.150         # M — physiological NaCl
export PRODUCTION_DT=0.002     # ps — 2 fs with HMR (P100 stability; matches production.in)
export PROD_TIMESTEP=0.002
export PROD_NSTLIM=10000000
export GPU_SPEED_NS_DAY=102
export EQUIL_DT=0.002          # ps — 2 fs for equilibration
export PME_CUTOFF=9.0          # angstrom

# Thermostat / barostat defaults (documented; mdin files are source of truth)
export THERMOSTAT="bussi"
export NTT_EQUIL=11
export NTT_CPU=3
export TAUTP=2.0
export BAROSTAT_EQUIL=1
export BAROSTAT_PROD=2
export MCBARINT=25
export PROD_ENSEMBLE="NPT"
# Re-imaged production trajectory (under simulations/<name>/prod/); created by preprocess_trajectory.sh / run_production.sh
export PROD_TRAJ_REIMAGED="production_reimaged.nc"

# Optional: absolute path to inhibitor mol2 (e.g. charge-corrected). If unset, use params/inhibitors/mol2/<tag>_gaff2.mol2
# or, if present, params/inhibitors/mol2/<tag>_chargecorrected.mol2 (see build_monomer_system.sh)
export LIGAND_MOL2_OVERRIDE="${LIGAND_MOL2_OVERRIDE:-}"

# Equilibration convergence gate (check_equil_convergence.py / gate_equil_convergence)
export EQUIL_NI1=570              # tLeap residue index of first Ni (mol6_pose2_monomer rebuild)
export EQUIL_NI2=571              # tLeap residue index of second Ni
export EQUIL_OHB=572              # tLeap residue index of OHB (reserved for future checks)
# Legacy short CPU file (optional); pipeline uses equil_cpu_npt.in for density convergence
export EQUIL_CPU_NSTLIM=2500
# CPU NPT before GPU — must match simulations/input_files/equil_cpu_npt.in nstlim
export EQUIL_CPU_NPT_NSTLIM=50000 # 100 ps at dt=0.002
# equil_free.in: nstlim must match simulations/input_files/equil_free.in
export EQUIL_FREE_NS=100
export EQUIL_FREE_NSTLIM=50000000  # 100 ns at dt=0.002 ps
# Pre-GPU density gate (run_equilibration.sh after equil_cpu; ~0.94+ OK after short CPU)
export EQUIL_DENSITY_TARGET=1.00  # g/cm³
export EQUIL_DENSITY_TOL=0.06     # ±0.06 g/cm³ before GPU (covers ~0.946 g/cm³ partial equil)
# Production: three independent replicates × 20 ns each (same equil_free.rst7, ig=-1)
export PROD_NS_PER_REP=20
export NREP=3
export PROD_TOTAL_NS=60
# Inhibitor count: 36 MD/ORCA systems total. Chemistry labels (see params/inhibitors/ligand_name_mapping.csv, column "compound"):
#   mol1 … mol33  (numbered series) + aha + dmj + thiourea  (= 33 + 3 = 36).
# Sequential batch IDs mol01 … mol36 are folder names under params/inhibitors/orca_opt/ (processing order), NOT "compound 1–36".
export N_COMPOUNDS=36
export PROD_TOTAL_NS_ALL=2160   # N_COMPOUNDS × 60 ns (project scope)
export SYSTEM_ATOMS_APPROX=99860
export NI1_RES=570
export NI2_RES=571
export OHB_RES=572
export EQUIL_DENSITY_MIN=0.990    # g/cm³
export EQUIL_DENSITY_MAX=1.010
export EQUIL_DENSITY_STD=0.005
export EQUIL_RMSD_DRIFT=0.5       # Å/ns max drift in last window
export EQUIL_RMSD_MAX=5.0         # Å max mean backbone RMSD in window
export EQUIL_NINI_MIN=3.21        # Å (crystal 3.51 − 0.30)
export EQUIL_NINI_MAX=3.81        # Å (crystal 3.51 + 0.30)
export EQUIL_NINI_STD=0.20        # Å max std of Ni–Ni in window
export EQUIL_WINDOW=0.25          # last fraction of equil_free for statistics

# Temperature gate (check_equil_convergence.py Check 4 — equil_free mdout)
export EQUIL_TEMP_MIN=295.0
export EQUIL_TEMP_MAX=305.0
export EQUIL_TEMP_MAXOBS=343.0
export EQUIL_TEMP_STD=10.0

# If 1, run_equilibration.sh launches run_production.sh after all gates pass
export LAUNCH_PRODUCTION_AFTER_EQUIL=1
# If 1, always run min1→equil_free from scratch (ignore resume from equil_cpu / equil1)
export EQUIL_FORCE_FULL="${EQUIL_FORCE_FULL:-0}"

# === Simulation unit (monomer vs dodecamer) ===
# This repository can assemble either the full dodecamer or a faster
# monomer heterodimer (one UreA + one UreB subunit).
export N_SUBUNITS=1
export N_NI_TOTAL=2
export N_NI_PER_SITE=2
export SYSTEM_TYPE="monomer_heterodimer"

# === PDB ===
export PDB_ID="6ZJA"
export PDB_URL="https://files.rcsb.org/download/${PDB_ID}.pdb"

# === Residue numbering (UPDATE after pdb4amber) ===
# Placeholders — MUST update after running pdb4amber
# with actual renumbered values from 6ZJA_clean_renum.txt
export RESIDUE_ATOMS_IN_CLUSTER=257    # DFT cluster size
export NI_FLIP_INDEX=249               # 0-based Ni index for BS-DFT

# === Logging ===
export LOG_LEVEL="INFO"
export LOG_DIR="${PROJECT_ROOT}/logs"
